# NEXUS Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Cache
DATABASE_URL=postgresql+asyncpg://nexus_user:nexus_secret_pass@localhost:5432/nexus_db
REDIS_URL=redis://localhost:6379/0

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Safety & Simulation Thresholds
FLOOD_SURGE_THRESHOLD_PERCENT=15.0
SAFETY_GATE_STRICT_MODE=true
